ENVIRONMENT=development
DATABASE_URL=sqlite:///./spendova.db
CORS_ORIGINS=http://localhost:5173
AUTH_REQUIRED=false
FIREBASE_PROJECT_ID=
EMAIL_DELIVERY_MODE=console
EMAIL_FROM=Spendova <no-reply@spendova.app>
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
OTP_SECRET=replace-with-a-long-random-secret
OTP_EXPIRY_MINUTES=10
PASSWORD_RESET_CODE_MINUTES=10
PASSWORD_RESET_TOKEN_MINUTES=15
# Public address used in email links (no trailing slash).
APP_URL=http://localhost:5173
# Firebase console > Project settings > Service accounts > Generate new private key.
# Paste the whole JSON on one line. Required to change passwords from the server.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Production email: set EMAIL_DELIVERY_MODE=smtp and fill the SMTP_* values.
# Port 587 uses STARTTLS (SMTP_USE_TLS=true); port 465 uses implicit TLS.

# Supabase direct connection example (server environments with IPv6):
# DATABASE_URL=postgresql+psycopg://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres
# Supabase session pooler example (works in most IPv4 environments):
# DATABASE_URL=postgresql+psycopg://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
