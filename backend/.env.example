# Spendova LOCAL backend configuration template
# Copy to backend/.env for local development. Never commit the filled-in file.
# Real process environment variables override backend/.env. Restart the backend after edits.
# Production: use .env.production.example as the Vercel environment-variable reference.

# --- Runtime -------------------------------------------------------------------
ENVIRONMENT=development
# Optional protected Swagger login (separate from Firebase). When false, docs are
# public locally and disabled in production. Never use real credentials here.
ENABLE_API_DOCS=false
SWAGGER_USERNAME=
SWAGGER_PASSWORD=
SWAGGER_SESSION_TTL_MINUTES=60
DATABASE_URL=sqlite:///./spendova.db
# Optional: Alembic uses this instead of DATABASE_URL when provided.
DIRECT_URL=
CORS_ORIGINS=http://localhost:5173
# Public address used in email links (no trailing slash).
APP_URL=http://localhost:5173

# --- Identity ------------------------------------------------------------------
AUTH_REQUIRED=false
JWT_ACCESS_SECRET=development-only-change-me
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# --- Keys (generate with: python -c "import secrets; print(secrets.token_urlsafe(48))") ---
OTP_SECRET=replace-with-a-long-random-secret
# Encrypts queued emails at rest. Changing it makes unsent queued emails unreadable.
DATA_ENCRYPTION_KEY=replace-with-a-long-random-secret
OTP_EXPIRY_MINUTES=10
PASSWORD_RESET_CODE_MINUTES=10
PASSWORD_RESET_TOKEN_MINUTES=15

# --- Email (local: Mailpit) -----------------------------------------------------
# Same SMTP path as production, delivered to Mailpit instead of real inboxes.
# Start it with `docker compose up -d mailpit` from the repo root, then read mail at
# http://127.0.0.1:8026. Mailpit needs no username, password, or TLS.
# No Docker? Set EMAIL_DELIVERY_MODE=console to print emails in the backend terminal
# (the sign-up and reset screens then also show the code).
EMAIL_DELIVERY_MODE=smtp
EMAIL_FROM=Spendova <no-reply@spendova.local>
SMTP_HOST=127.0.0.1
SMTP_PORT=1026
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=false
SMTP_TIMEOUT_SECONDS=10
# Optional (32+ characters): unlocks POST /health/email test sends. Never the SMTP password.
# EMAIL_TEST_API_KEY=
# Durable outbox: failed or interrupted sends are retried with backoff.
EMAIL_OUTBOX_WORKER_ENABLED=true
EMAIL_OUTBOX_POLL_SECONDS=30
EMAIL_OUTBOX_MAX_ATTEMPTS=8

# --- Rate limits (per client IP, per instance) ----------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_GLOBAL_REQUESTS=300
RATE_LIMIT_AUTH_REQUESTS=10

# --- Supabase connection examples ----------------------------------------------
# Direct connection (server environments with IPv6):
# DIRECT_URL=postgresql+psycopg://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres?sslmode=require
# Session pooler (works in most IPv4 environments):
# DIRECT_URL=postgresql+psycopg://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require
# Transaction pooler (recommended for a serverless API):
# DATABASE_URL=postgresql+psycopg://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require

# Optional finance assistant (backend only; never VITE_*).
# AI use is opt-in per chat request. Local summaries and calculators work without a key.
OPENAI_API_KEY=
FINANCE_ASSISTANT_MODEL=gpt-4.1-mini
RATE_LIMIT_ASSISTANT_REQUESTS=10

# Shared daily AI allowance (Settings may choose a lower value, including 0 to pause).
FINANCE_ASSISTANT_DAILY_TOKEN_LIMIT=20000
FINANCE_ASSISTANT_MAX_DAILY_TOKENS=100000
FINANCE_ASSISTANT_RESET_TIMEZONE=Asia/Kolkata
# Reminders require explicit user opt-in in Settings. Vercel uses the existing cron route.
REMINDERS_ENABLED=true
REMINDER_POLL_SECONDS=300
