ENVIRONMENT=development
DATABASE_URL=sqlite:///./spendova.db
CORS_ORIGINS=http://localhost:5173
AUTH_REQUIRED=false
FIREBASE_PROJECT_ID=
EMAIL_DELIVERY_MODE=console
EMAIL_FROM=Spendova <no-reply@spendova.app>
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
OTP_SECRET=replace-with-a-long-random-secret
OTP_EXPIRY_MINUTES=10

# Supabase direct connection example (server environments with IPv6):
# DATABASE_URL=postgresql+psycopg://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres
# Supabase session pooler example (works in most IPv4 environments):
# DATABASE_URL=postgresql+psycopg://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
