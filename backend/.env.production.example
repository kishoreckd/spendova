# Spendova PRODUCTION backend environment-variable template (Vercel)
# Never put real credentials in this example or commit a populated env file.
# Set these in the backend Vercel project: Settings > Environment Variables (Production).
# Vercel sets VERCEL=1 itself; that switches off the in-process email worker and connection pool.
# With ENVIRONMENT=production the API refuses to start unless every REQUIRED value is set:
# AUTH_REQUIRED=true; JWT_ACCESS_SECRET, OTP_SECRET and DATA_ENCRYPTION_KEY (32+ characters each);
# EMAIL_DELIVERY_MODE=smtp, SMTP_HOST, SMTP_USERNAME, SMTP_PASSWORD and EMAIL_FROM.
# Redeploy after changes. Do not reuse local-development secrets.

# --- Runtime -------------------------------------------------------------------
APP_NAME=Spendova API
APP_VERSION=0.8.0
ENVIRONMENT=production
# Docs remain disabled unless enabled with separate documentation credentials.
ENABLE_API_DOCS=false
SWAGGER_USERNAME=
SWAGGER_PASSWORD=
SWAGGER_SESSION_TTL_MINUTES=60
# REQUIRED: Supabase PostgreSQL URI. For serverless use the TRANSACTION pooler (port 6543):
# postgresql+psycopg://postgres.[PROJECT_REF]:[URL_ENCODED_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
# (Migrations run from GitHub Actions with the session pooler, port 5432 â€” see migrate-database.yml.)
DATABASE_URL=

DIRECT_URL=
# Public HTTPS frontend origin, no trailing slash. APP_URL controls email links.
APP_URL=https://spendova-jet.vercel.app
CORS_ORIGINS=https://spendova-jet.vercel.app

# --- Identity ------------------------------------------------------------------
AUTH_REQUIRED=true
JWT_ACCESS_SECRET=
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
REFRESH_COOKIE_NAME=spendova_refresh

# --- Keys ----------------------------------------------------------------------
# REQUIRED: separate random session, OTP and encryption secrets. Generate each once:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Keep DATA_ENCRYPTION_KEY stable: changing it makes unsent queued emails unreadable.
OTP_SECRET=
DATA_ENCRYPTION_KEY=
OTP_EXPIRY_MINUTES=10
PASSWORD_RESET_CODE_MINUTES=10
PASSWORD_RESET_TOKEN_MINUTES=15

# --- Email (Brevo SMTP) -------------------------------------------------------
# Brevo uses STARTTLS on 587. SMTP_USERNAME is the Brevo SMTP login and SMTP_PASSWORD is the
# Brevo SMTP key (Brevo > SMTP & API > SMTP), not your Brevo account password.
# EMAIL_FROM must be a sender verified in Brevo, e.g. Spendova <no-reply@YOUR_DOMAIN>.
# Gmail alternative: SMTP_HOST=smtp.gmail.com, your address as SMTP_USERNAME, and a Google
# App Password (needs 2-step verification) as SMTP_PASSWORD â€” never the normal Gmail password.
EMAIL_DELIVERY_MODE=smtp
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_TIMEOUT_SECONDS=10
EMAIL_FROM=
# Optional: dedicated secret (32+ characters) for POST /health/email test sends.
# Leave unset to disable test sending. Never use the SMTP password here.
# EMAIL_TEST_API_KEY=
EMAIL_OUTBOX_MAX_ATTEMPTS=8
EMAIL_OUTBOX_WORKER_ENABLED=false
EMAIL_OUTBOX_POLL_SECONDS=30
EMAIL_OUTBOX_DEFAULT_TTL_HOURS=24
EMAIL_OUTBOX_RETENTION_DAYS=30
# Emails are sent right after each request. Failed ones are retried by Vercel Cron calling
# /cron/email-outbox (schedule in backend/vercel.json). Vercel sends this as a Bearer token.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
CRON_SECRET=

# --- Rate limits (per client IP, per serverless instance â€” approximate on Vercel) ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_GLOBAL_REQUESTS=300
RATE_LIMIT_AUTH_REQUESTS=10
RATE_LIMIT_REFRESH_REQUESTS=120

# Optional finance assistant (backend only; never VITE_*).
# AI use is opt-in per chat request. Local summaries and calculators work without a key.
OPENAI_API_KEY=
FINANCE_ASSISTANT_MODEL=gpt-4.1-mini
RATE_LIMIT_ASSISTANT_REQUESTS=10

# Shared daily AI allowance (Settings may choose a lower value, including 0 to pause).
FINANCE_ASSISTANT_DAILY_TOKEN_LIMIT=20000
FINANCE_ASSISTANT_MAX_DAILY_TOKENS=100000
FINANCE_ASSISTANT_RESET_TIMEZONE=Asia/Kolkata
# Reminders require explicit user opt-in in Settings. Vercel uses the existing cron route.
REMINDERS_ENABLED=true
REMINDER_POLL_SECONDS=300
