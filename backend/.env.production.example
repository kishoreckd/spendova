# Spendova PRODUCTION backend environment-variable template (Vercel)
# Never put real credentials in this example or commit a populated env file.
# Set these in the backend Vercel project: Settings > Environment Variables (Production).
# Vercel sets VERCEL=1 itself; that switches off the in-process email worker and connection pool.
# With ENVIRONMENT=production the API refuses to start unless every REQUIRED value is set:
# AUTH_REQUIRED=true, FIREBASE_PROJECT_ID, OTP_SECRET and DATA_ENCRYPTION_KEY (32+ random
# characters each), EMAIL_DELIVERY_MODE=smtp, SMTP_HOST, SMTP_USERNAME, SMTP_PASSWORD, EMAIL_FROM.
# Redeploy after changes. Do not reuse local-development secrets.

# --- Runtime -------------------------------------------------------------------
ENVIRONMENT=production
# REQUIRED: Supabase PostgreSQL URI. For serverless use the TRANSACTION pooler (port 6543):
# postgresql+psycopg://postgres.[PROJECT_REF]:[URL_ENCODED_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
# (Migrations run from GitHub Actions with the session pooler, port 5432 — see migrate-database.yml.)
DATABASE_URL=
# Public HTTPS frontend origin, no trailing slash. APP_URL controls email links.
APP_URL=https://spendova-jet.vercel.app
CORS_ORIGINS=https://spendova-jet.vercel.app

# --- Identity ------------------------------------------------------------------
AUTH_REQUIRED=true
FIREBASE_PROJECT_ID=spendova-a6d20
# REQUIRED for password reset: Firebase service-account JSON on one line. Server only.
FIREBASE_SERVICE_ACCOUNT_JSON=

# --- Keys ----------------------------------------------------------------------
# REQUIRED: two different random secrets. Generate each once:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Keep DATA_ENCRYPTION_KEY stable: changing it makes unsent queued emails unreadable.
OTP_SECRET=
DATA_ENCRYPTION_KEY=
OTP_EXPIRY_MINUTES=10
PASSWORD_RESET_CODE_MINUTES=10
PASSWORD_RESET_TOKEN_MINUTES=15

# --- Email (Brevo SMTP) -------------------------------------------------------
# Brevo uses STARTTLS on 587. SMTP_USERNAME is the Brevo SMTP login and SMTP_PASSWORD is the
# Brevo SMTP key (Brevo > SMTP & API > SMTP), not your Brevo account password.
# EMAIL_FROM must be a sender verified in Brevo, e.g. Spendova <no-reply@YOUR_DOMAIN>.
# Gmail alternative: SMTP_HOST=smtp.gmail.com, your address as SMTP_USERNAME, and a Google
# App Password (needs 2-step verification) as SMTP_PASSWORD — never the normal Gmail password.
EMAIL_DELIVERY_MODE=smtp
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_TIMEOUT_SECONDS=10
EMAIL_FROM=
# Optional: dedicated secret (32+ characters) for POST /health/email test sends.
# Leave unset to disable test sending. Never use the SMTP password here.
# EMAIL_TEST_API_KEY=
EMAIL_OUTBOX_MAX_ATTEMPTS=8
# Emails are sent right after each request. Failed ones are retried by Vercel Cron calling
# /cron/email-outbox (schedule in backend/vercel.json). Vercel sends this as a Bearer token.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
CRON_SECRET=

# --- Rate limits (per client IP, per serverless instance — approximate on Vercel) ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_GLOBAL_REQUESTS=300
RATE_LIMIT_AUTH_REQUESTS=10
